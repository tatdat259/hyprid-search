# Qdrant Vector Database Configuration (Optional - defaults to local embedded storage)
# QDRANT_URL=https://your-cluster-id.eu-central.aws.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# SEC EDGAR Custom User-Agent (Optional - defaults to research header)
# EDGAR_USER_AGENT=FinancialIntelligenceResearch/1.0 (research@example.com)

# Gemini RAG (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
RAG_TOP_K=20
RAG_MAX_CONTEXT_TOKENS=8000
RAG_MAX_OUTPUT_TOKENS=4096
RAG_TOTAL_TIMEOUT_SECONDS=45